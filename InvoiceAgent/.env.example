# InvoiceAgent — required credentials
#
# n8n stores credentials in its own Credentials UI, not as env vars — this
# file just documents what each integration needs so you know what to have
# on hand before configuring the four credentials in n8n.

# ── Gmail ─────────────────────────────────────────────────────────────────
# OAuth2 app from Google Cloud Console (Gmail API enabled). Used by the
# "Gmail Trigger" node to poll for invoice emails.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Groq ──────────────────────────────────────────────────────────────────
# API key from console.groq.com. Powers the "Groq Model" subnode that reads
# invoice text and extracts structured fields.
GROQ_API_KEY=
# Model the workflow is configured to use — change here + in the node if you
# switch models (must support function calling for Information Extractor).
GROQ_MODEL=llama-3.1-8b-instant

# ── Google Drive ──────────────────────────────────────────────────────────
# OAuth2 app from Google Cloud Console (Drive API enabled). Used by "Upload
# to Google Drive" to store the original invoice PDF.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# The Drive folder ID where invoices get filed (open the folder in Drive,
# copy the ID from the URL after /folders/). Paste this into the node's
# folderId field, replacing REPLACE_WITH_INVOICES_FOLDER_ID.
GOOGLE_DRIVE_INVOICES_FOLDER_ID=

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL and service role key from Supabase project settings > API.
# Used by "Insert Invoice (Supabase)" to write extracted invoice records.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Table name the node writes to — must match supabase_schema.sql.
SUPABASE_TABLE=invoices
