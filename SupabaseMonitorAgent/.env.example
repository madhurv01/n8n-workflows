# ── Config for the Supabase Monitoring workflow (single project) ──────────
# n8n's free/cloud plan blocks Code nodes from reading process.env, so this
# workflow doesn't use environment variables at all. Instead, open the
# "Monitor Config" node (a Set/Edit Fields node right after the schedule
# trigger) in the workflow and fill in the same values there:

# The one Supabase project being monitored (also stores the monitoring
# history — no separate central project needed)
MON_CENTRAL_URL=https://your-project-ref.supabase.co
MON_CENTRAL_KEY=eyJhbGciOi...   # service_role key of the project

# Report recipient (comma-separated for multiple)
MON_REPORT_TO=ops@yourcompany.com

# This file is kept only as a reference for which values to fill in on the
# "Monitor Config" node — it is not read by n8n or the workflow.
