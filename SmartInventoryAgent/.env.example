# ── Config reference for the Smart Inventory Agent workflow ───────────────
# n8n's free/cloud plan blocks Code nodes from reading process.env, so this
# workflow does NOT read environment variables at runtime. Every value below
# is instead entered directly into an n8n node (Credential or the "Agent
# Config" Set node). This file exists only as a reference for which values
# go where — it is never read by n8n or the workflow itself, and it is safe
# to commit (no real secrets, placeholders only).

# ── Supabase credential (n8n: Credentials → New → Supabase API) ───────────
# Used by the "Get Inventory Items" and "Update Inventory" nodes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key — NOT the anon key (RLS blocks writes from anon)

# ── Gmail credential (n8n: Credentials → New → Gmail OAuth2 API) ──────────
# Used by the "Send Report Email" node. Connect via n8n's OAuth2 flow;
# there is no client secret to paste here — this is just the account.
GMAIL_ACCOUNT_EMAIL=you@example.com

# ── "Agent Config" node (Set/Edit Fields node, right after the schedule) ──
# Open the node in the n8n canvas and fill in the same values there:
AGENT_LOCATION_NAME=Mumbai Warehouse          # must exactly match inventory_items.location_name
AGENT_LATITUDE=19.076
AGENT_LONGITUDE=72.8777
AGENT_SUPABASE_TABLE=inventory_items
AGENT_LOW_STOCK_MULTIPLIER=1.5                # stock <= reorder_threshold * multiplier counts as "low"
AGENT_ALERT_EMAIL=ops-team@example.com        # report recipient

# ── Weather data ───────────────────────────────────────────────────────
# No credential needed — https://api.open-meteo.com is free and keyless.
