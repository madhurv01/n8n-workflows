# -----------------------------------------------------------------------------
# Order Monitor Agent — environment variable template
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the actual ".env" file — only this .example file belongs in git.
# -----------------------------------------------------------------------------

# --- Supabase (source of the webhook events) ------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key (used only by Supabase to sign/send the DB webhook, not by n8n)
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n Webhook (this workflow's inbound endpoint) ------------------------
# Base URL n8n is reachable at (e.g. your ngrok/tunnel or public domain)
N8N_WEBHOOK_BASE_URL=
# Must match the "path" set on the Webhook node: supabase-order-update
N8N_WEBHOOK_PATH=supabase-order-update

# --- Gmail (used by both "Send a message" and "Send a message1" nodes) -----
# OAuth2 Client ID / Secret from Google Cloud Console (Gmail API enabled)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Mailbox that sends the notifications
GMAIL_SENDER_ADDRESS=
# Recipient addresses used in the workflow (override the hardcoded demo values)
GMAIL_ADMIN_RECIPIENT=governmentadmin2@gmail.com
GMAIL_VENDOR_RECIPIENT=testvendor2108@gmail.com

# --- Twilio (used by "Send an SMS/MMS/WhatsApp message" node) --------------
# Found in Twilio Console dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp-enabled sender number, e.g. +14155238886 (sandbox default)
TWILIO_FROM_NUMBER=
# Destination number that receives the WhatsApp alert
TWILIO_TO_NUMBER=
