# Chat With Your PDF Bot — required credential values
#
# This workflow does NOT read these as actual environment variables at runtime —
# n8n credentials are stored in n8n's own credential store, not in a .env file.
# This file just documents every value you need to have on hand when creating
# each credential in the n8n UI (Credentials -> New), and can double as a
# reference if you script credential creation via the n8n API/CLI instead.

# ── Telegram Bot ────────────────────────────────────────────────────────────
# Credential name in n8n: "Telegram account"
# Credential type: telegramApi
# Get this from @BotFather on Telegram (/newbot, or /token for an existing bot).
# Reuses the existing "Telegram account" credential in this n8n instance if you
# don't need a dedicated bot for this workflow.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotTokenReplaceMe

# ── Google Gemini (embeddings + chat model) ─────────────────────────────────
# Credential name in n8n: "Google Gemini(PaLM) Api account"
# Credential type: googlePalmApi
# Get this from https://aistudio.google.com/app/apikey
# Reuses the existing "Google Gemini(PaLM) Api account" credential in this
# n8n instance — must have access to models/text-embedding-004 and
# models/gemini-2.0-flash.
GOOGLE_GEMINI_API_KEY=AIzaSyExampleGeminiApiKeyReplaceMe

# ── Pinecone (vector database) ──────────────────────────────────────────────
# Credential name in n8n: "Pinecone account"  <-- NOT yet created in this instance
# Credential type: pineconeApi
# Get this from https://app.pinecone.io -> API Keys
PINECONE_API_KEY=pcsk_ExamplePineconeApiKeyReplaceMe

# The Pinecone index to store/search PDF chunks in. Create it in the Pinecone
# console (or via API) BEFORE running the workflow:
#   - Dimensions: 768        (must match Gemini text-embedding-004 output size)
#   - Metric:     cosine     (recommended default)
#   - Cloud/Region: your choice (e.g. aws / us-east-1 on the free tier)
# Then open both Pinecone nodes in the workflow and reselect this index name
# in the Pinecone Index picker — the shipped JSON has a placeholder value.
PINECONE_INDEX_NAME=chat-with-pdf-index

# Optional: Pinecone environment/region string, only needed for some older
# Pinecone credential setups (pod-based projects). Serverless projects
# (current default) don't need this.
# PINECONE_ENVIRONMENT=us-east-1-aws
