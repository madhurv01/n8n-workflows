{
  "name": "Chat With Your PDF Bot (Telegram + Gemini + Pinecone)",
  "nodes": [
    {
      "id": "tg-trigger-1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "chat-with-pdf-telegram-trigger",
      "parameters": {
        "updates": ["message"]
      },
      "credentials": {
        "telegramApi": { "name": "Telegram account" }
      }
    },
    {
      "id": "has-doc-if-1",
      "name": "Has Document?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.message.document }}",
              "operator": { "type": "object", "operation": "exists" },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "download-pdf-1",
      "name": "Download PDF from Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 140],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.message.document.file_id }}",
        "download": true
      },
      "credentials": {
        "telegramApi": { "name": "Telegram account" }
      }
    },
    {
      "id": "extract-pdf-1",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [720, 140],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data"
      }
    },
    {
      "id": "text-splitter-1",
      "name": "Recursive Character Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [840, -60],
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 200
      }
    },
    {
      "id": "doc-loader-1",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [960, 60],
      "parameters": {
        "dataType": "binary",
        "binaryDataKey": "data"
      }
    },
    {
      "id": "embeddings-store-1",
      "name": "Embeddings Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [1080, 260],
      "parameters": {
        "modelName": "models/text-embedding-004"
      },
      "credentials": {
        "googlePalmApi": { "name": "Google Gemini(PaLM) Api account" }
      }
    },
    {
      "id": "pinecone-insert-1",
      "name": "Store PDF in Pinecone",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [960, 140],
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "mode": "list",
          "value": "chat-with-pdf-index",
          "cachedResultName": "chat-with-pdf-index"
        },
        "options": {}
      },
      "credentials": {
        "pineconeApi": { "name": "Pinecone account" }
      }
    },
    {
      "id": "confirm-upload-1",
      "name": "Confirm Upload",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1200, 140],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=✅ Got your PDF (\"{{ $('Telegram Trigger').item.json.message.document.file_name }}\"). I've read it and stored it in memory — ask me anything about it!",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "name": "Telegram account" }
      }
    },
    {
      "id": "embeddings-query-1",
      "name": "Embeddings Google Gemini (Query)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [480, 620],
      "parameters": {
        "modelName": "models/text-embedding-004"
      },
      "credentials": {
        "googlePalmApi": { "name": "Google Gemini(PaLM) Api account" }
      }
    },
    {
      "id": "pinecone-tool-1",
      "name": "Search PDF Knowledge",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [480, 480],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "search_pdf_knowledge",
        "toolDescription": "Searches the previously uploaded PDF documents for relevant passages to answer the user's question. Always use this before answering a question about the PDF.",
        "pineconeIndex": {
          "__rl": true,
          "mode": "list",
          "value": "chat-with-pdf-index",
          "cachedResultName": "chat-with-pdf-index"
        },
        "topK": 4,
        "options": {}
      },
      "credentials": {
        "pineconeApi": { "name": "Pinecone account" }
      }
    },
    {
      "id": "gemini-chat-model-1",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [600, 620],
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": { "temperature": 0.3 }
      },
      "credentials": {
        "googlePalmApi": { "name": "Google Gemini(PaLM) Api account" }
      }
    },
    {
      "id": "chat-memory-1",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [720, 620],
      "parameters": {
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "sessionIdType": "customKey",
        "contextWindowLength": 10
      }
    },
    {
      "id": "pdf-qa-agent-1",
      "name": "PDF Q&A Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [480, 300],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "You are a helpful assistant that answers questions strictly using the content of PDF documents the user has uploaded to this Telegram bot. Use the 'search_pdf_knowledge' tool to look up relevant passages before answering. If the answer isn't found in the retrieved passages, say you don't know based on the uploaded PDF(s) instead of guessing. Keep answers concise and cite the relevant part of the document when helpful.",
          "maxIterations": 6
        }
      }
    },
    {
      "id": "send-reply-1",
      "name": "Send Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "name": "Telegram account" }
      }
    },
    {
      "id": "sticky-1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -140],
      "parameters": {
        "content": "## Chat With Your PDF Bot\nTelegram + Google Gemini + Pinecone\n\nUpload a PDF to the bot -> it's chunked, embedded (Gemini text-embedding-004), and stored in Pinecone.\nThen ask questions in the same chat -> an AI Agent (Gemini 2.0 Flash) searches Pinecone and answers using only the PDF content, with short-term chat memory per Telegram chat.\n\nBefore running: create a Pinecone index, add the 'Pinecone account' credential, and confirm the Telegram + Google Gemini credentials in each node.",
        "color": 4,
        "width": 420,
        "height": 260
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Has Document?", "type": "main", "index": 0 }]]
    },
    "Has Document?": {
      "main": [
        [{ "node": "Download PDF from Telegram", "type": "main", "index": 0 }],
        [{ "node": "PDF Q&A Agent", "type": "main", "index": 0 }]
      ]
    },
    "Download PDF from Telegram": {
      "main": [[{ "node": "Extract PDF Text", "type": "main", "index": 0 }]]
    },
    "Extract PDF Text": {
      "main": [[{ "node": "Store PDF in Pinecone", "type": "main", "index": 0 }]]
    },
    "Store PDF in Pinecone": {
      "main": [[{ "node": "Confirm Upload", "type": "main", "index": 0 }]]
    },
    "Recursive Character Text Splitter": {
      "ai_textSplitter": [[{ "node": "Default Data Loader", "type": "ai_textSplitter", "index": 0 }]]
    },
    "Default Data Loader": {
      "ai_document": [[{ "node": "Store PDF in Pinecone", "type": "ai_document", "index": 0 }]]
    },
    "Embeddings Google Gemini": {
      "ai_embedding": [[{ "node": "Store PDF in Pinecone", "type": "ai_embedding", "index": 0 }]]
    },
    "Embeddings Google Gemini (Query)": {
      "ai_embedding": [[{ "node": "Search PDF Knowledge", "type": "ai_embedding", "index": 0 }]]
    },
    "Search PDF Knowledge": {
      "ai_tool": [[{ "node": "PDF Q&A Agent", "type": "ai_tool", "index": 0 }]]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [[{ "node": "PDF Q&A Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "Chat Memory": {
      "ai_memory": [[{ "node": "PDF Q&A Agent", "type": "ai_memory", "index": 0 }]]
    },
    "PDF Q&A Agent": {
      "main": [[{ "node": "Send Reply", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Built offline without live n8n API validation (n8n MCP tools were disconnected). Import via Workflows -> Import from File, then verify credentials and the Pinecone index picker on both Pinecone nodes before activating."
  }
}
