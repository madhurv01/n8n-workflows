    {
      "parameters": {
        "jsCode": "const baseUrl = \"https://www.pinterest.com\";\n\nconst links = ($json.links || []).map(link => {\n  if (!link) return null;\n\n  if (link.startsWith(\"http\")) {\n    return link;\n  }\n\n  if (link.startsWith(\"/\")) {\n    return baseUrl + link;\n  }\n\n  return baseUrl + \"/\" + link;\n}).filter(Boolean);\n\nconst images = [...new Set($json.images || [])];\n\nreturn [{\n  json: {\n    links: [...new Set(links)],\n    images\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        -192
      ],
      "id": "d412f1d3-18e0-44d7-b4b5-dc4d575249fb",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const links = $json.links || [];\nconst images = $json.images || [];\n\nreturn [\n  ...links.map(link => ({ json: { type: \"link\", value: link } })),\n  ...images.map(image => ({ json: { type: \"image\", value: image } }))\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
