    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => ({\n  json: {\n    link: `=HYPERLINK(\"${item.json.link}\", \"${item.json.link}\")`,\n    image: `=IMAGE(\"${item.json.image}\")`\n  }\n}));"
      },
