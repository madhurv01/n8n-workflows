    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\n\n// --- Build a normalized lookup so header spacing/casing mismatches can't break it ---\nfunction getField(row, targetKey) {\n  const normalizedTarget = targetKey.replace(/\\s+/g, '').toLowerCase();\n  for (const key in row) {\n    if (key.replace(/\\s+/g, '').toLowerCase() === normalizedTarget) {\n      return row[key];\n    }\n  }\n  return '';\n}\n\nconst errors = [];\n\n// --- Name ---\nconst name = getField(row, 'YOUR FULL NAME').toString().trim();\n\nif (!name) {\n  errors.push('Missing name');\n} else if (/\\d/.test(name)) {\n  errors.push('Invalid name: must not contain numbers');\n} else if (!/^[A-Za-z\\s.'-]+$/.test(name)) {\n  errors.push('Invalid name: contains disallowed characters');\n}\n\n// --- Personnel number ---\nconst rawPhone = getField(row, 'PERSONNEL NUMBER').toString().trim();\nlet phone = rawPhone.replace(/\\D/g, '');\n\nif (phone.length === 12 && phone.startsWith('91')) {\n  phone = phone.slice(2);\n} else if (phone.length === 11 && phone.startsWith('0')) {\n  phone = phone.slice(1);\n}\n\nif (phone.length !== 10 || !/^[6789]/.test(phone)) {\n  errors.push('Invalid Indian mobile number: must be 10 digits starting with 6, 7, 8, or 9');\n}\n\n// --- Other fields ---\nconst gender = getField(row, 'YOUR GENDER');\nconst doctor = getField(row, 'APPOINTMENT WITH DOCTOR');\nconst dayStr = getField(row, 'APPOINTMENT DAY');\nconst timeStr = getField(row, 'APPOINTMENT TIME').toString().trim();\n\nif (!gender) errors.push('Missing gender');\nif (!doctor) errors.push('Missing doctor');\n\n// --- Date validation ---\nconst [d, m, y] = (dayStr || '').split('/').map(Number);\nconst apptDate = new Date(y, (m - 1), d);\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nif (!d || !m || !y || isNaN(apptDate.getTime()) || apptDate < today) {\n  errors.push('Invalid or past appointment date');\n}\n\n// --- Time validation ---\nif (!/^([01]\\d|2[0-3]):([0-5]\\d):([0-5]\\d)$/.test(timeStr)) {\n  errors.push('Invalid appointment time format');\n}\n\n// --- Simple hash for dedup ---\nfunction simpleHash(str) {\n  let hash = 0;\n  for (let i = 0; i < str.length; i++) {\n    hash = ((hash << 5) - hash) + str.charCodeAt(i);\n    hash |= 0;\n  }\n  return Math.abs(hash).toString(16);\n}\n\nconst rowHash = simpleHash(name + phone + dayStr + timeStr);\n\nconst isoDate = !isNaN(apptDate.getTime())\n  ? `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`\n  : null;\n\nreturn {\n  json: {\n    full_name: name,\n    gender: gender,\n    personnel_number: phone,\n    doctor: doctor,\n    appointment_day: isoDate,\n    appointment_time: timeStr,\n    row_hash: rowHash,\n    is_valid: errors.length === 0,\n    errors: errors.join('; ')\n  }\n};"
      },
